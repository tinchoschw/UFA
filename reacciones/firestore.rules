rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.email == 'TU_EMAIL@ejemplo.com'; }
    // la TV se vincula por QR: el admin guarda su uid en screen/tv
    function tv() { return request.auth != null
      && exists(/databases/$(database)/documents/screen/tv)
      && get(/databases/$(database)/documents/screen/tv).data.uid == request.auth.uid; }
    // sesión de celu vigente: se abre escaneando el QR (token) y dura 30 min
    function sesOk() { return request.auth != null
      && request.time < get(/databases/$(database)/documents/ses/$(request.auth.uid)).data.ts + duration.value(30, 'm'); }

    match /cfg/{d} { allow read: if request.auth != null; allow write: if admin(); }
    match /screen/tv { allow read: if request.auth != null; allow write: if admin(); }
    match /screen/token { allow read, write: if admin() || tv(); }
    match /stats/{d} { allow read, write: if admin() || tv(); }
    match /ses/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tk', 'ts'])
        && request.resource.data.ts == request.time
        && request.resource.data.tk in [
          get(/databases/$(database)/documents/screen/token).data.cur,
          get(/databases/$(database)/documents/screen/token).data.prev];
    }
    match /rx/{id} {
      allow create: if sesOk() && request.resource.data.keys().hasOnly(['uid', 'ts', 'c'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.c.size() > 0
        && request.resource.data.c.keys().hasOnly(['fuego', 'amor', 'birra', 'baile', 'fiesta', 'diablo']);
      allow read, delete: if admin() || tv();
    }
    match /ph/{id} {
      allow create: if sesOk() && request.resource.data.keys().hasOnly(['uid', 'ts', 'img'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.img is string && request.resource.data.img.size() < 150000;
      allow read, delete: if admin() || tv();
    }
  }
}
